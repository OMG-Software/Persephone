{
  "productName": "Persephone",
  "version": "0.0.0",
  "identifier": "io.github.omg-software.persephone",
  "build": {
    "frontendDist": "../.local/build/frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'none'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "worker-src": "'none'",
        "manifest-src": "'none'",
        "media-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm", "app", "dmg"],
    "publisher": "OMG-Software",
    "copyright": "Copyright OMG-Software",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/OMG-Software/Persephone",
    "category": "SocialNetworking",
    "shortDescription": "Matrix desktop client",
    "longDescription": "Persephone is a Matrix desktop client with end-to-end encrypted chats. This is a pre-release with open security gates; it is not for high-risk use.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "version": "0.0.0",
        "upgradeCode": "6c3031c6-7503-5143-9dc0-8b5ef49ea8d1"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    }
  }
}
