{
  "identifier": "main",
  "description": "The main window may call the app's view, subscription, session lock, profile reset, sign-in, sign-out, encryption and sending commands and nothing else: no core plugin, event, window, path or webview permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-app-status",
    "allow-room-list",
    "allow-timeline-page",
    "allow-subscribe-room",
    "allow-unsubscribe-room",
    "allow-watch-session",
    "allow-lock-session",
    "allow-unlock-session",
    "allow-reset-profile",
    "allow-sign-in",
    "allow-sign-out",
    "allow-security-status",
    "allow-set-up-encryption",
    "allow-recover-with-key",
    "allow-send-message",
    "allow-pending-messages",
    "allow-retry-message",
    "allow-discard-message",
    "allow-allow-unencrypted",
    "allow-set-up-recovery",
    "allow-verify-this-device",
    "allow-accept-verification",
    "allow-confirm-verification",
    "allow-cancel-verification",
    "allow-contact-status",
    "allow-verify-contact",
    "allow-identity-changes",
    "allow-accept-identity"
  ]
}
